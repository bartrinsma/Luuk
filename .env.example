# Kopieer naar .env.local. Alles is optioneel: zonder keys draait Luuk in demo-modus.

# --- AI (Luuk's stem) ---
# Provider: anthropic | openai | mock (leeg = automatisch op basis van welke key er is)
LUUK_AI_PROVIDER=
ANTHROPIC_API_KEY=
# LUUK_ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# LUUK_OPENAI_MODEL=gpt-4o-mini

# --- Auto's: RDW Open Data (werkt zonder token; token geeft hogere rate limits) ---
RDW_APP_TOKEN=

# --- Huizen: externe WOZ/Kadaster-provider (anders: PDOK-adres + Luuk's mock-model) ---
KADASTER_API_URL=
KADASTER_API_KEY=

# --- Roast: Google PageSpeed Insights voor de echte mobiele score ---
PAGESPEED_API_KEY=

# --- Delen: e-mail via Resend (zonder key: demo-modus, er wordt niets verstuurd) ---
RESEND_API_KEY=
# Afzender moet een geverifieerd domein in Resend zijn, bijv. "Luuk.si <luuk@luuk.si>"
RESEND_FROM=
# Publieke basis-URL voor deel-links in e-mails (anders: origin van het request)
NEXT_PUBLIC_SITE_URL=

# --- Huizen: gevelfoto via Google Street View Static API (anders: Funda-foto of PDOK-luchtfoto) ---
# Zet in Google Cloud "Street View Static API" aan en beperk de key tot die API.
GOOGLE_MAPS_API_KEY=

# --- Admin & analytics ---
# Wachtwoord voor /admin (zonder deze variabele staat het admin-gedeelte dicht)
ADMIN_PASSWORD=
# Optioneel: los geheim voor het ondertekenen van de admin-sessie (anders afgeleid van het wachtwoord)
ADMIN_SECRET=
# Postgres voor blijvende analytics (Netlify DB zet NETLIFY_DATABASE_URL zelf; anders bijv. Neon/Supabase)
DATABASE_URL=
# Optioneel: zout voor de anonieme bezoekershash; LUUK_ANALYTICS=off schakelt tracking uit
ANALYTICS_SALT=
LUUK_ANALYTICS=
