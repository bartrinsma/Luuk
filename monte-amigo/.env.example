# Kopieer naar .env.local. Alles is optioneel behalve ADMIN_PASSWORD (anders blijft /admin dicht).

# Wachtwoord voor /admin
ADMIN_PASSWORD=
# Optioneel: los geheim voor het ondertekenen van de sessie
ADMIN_SECRET=

# Postgres (Netlify DB zet NETLIFY_DATABASE_URL zelf; anders bijv. Neon/Supabase).
# Zonder database-URL: lokale PGlite in .data/ (op serverless NIET blijvend!).
DATABASE_URL=

# Melding per e-mail bij een nieuwe reserveringsaanvraag (Resend). Leeg = geen mail.
RESEND_API_KEY=
RESEND_FROM="Monte Amigo <reserveren@monte-amigo.nl>"
NOTIFY_EMAIL=rentalmonteamigo@gmail.com

# Koppeling met tickets.onlinemetbart.nl (kan ook in /admin/instellingen)
TICKETS_API_URL=https://tickets.onlinemetbart.nl
TICKETS_API_KEY=
